job_application factorial(n) {
    vibe_check (n <= 1) {
        its_giving 1
    }
    its_giving n * factorial(n - 1)
}

job_application fibonacci(n) {
    vibe_check (n <= 1) {
        its_giving n
    }
    its_giving fibonacci(n - 1) + fibonacci(n - 2)
}

squad Stack {
    job_application constructor() {
        me_fr.items = []
    }

    job_application push(item) {
        me_fr.items.push(item)
    }

    job_application pop() {
        vibe_check (me_fr.items.length == 0) {
            its_giving ghost
        }
        its_giving me_fr.items.pop()
    }

    job_application peek() {
        vibe_check (me_fr.items.length == 0) {
            its_giving ghost
        }
        its_giving me_fr.items[me_fr.items.length - 1]
    }

    job_application isEmpty() {
        its_giving me_fr.items.length == 0
    }

    job_application size() {
        its_giving me_fr.items.length
    }
}

squad Queue {
    job_application constructor() {
        me_fr.items = []
    }

    job_application enqueue(item) {
        me_fr.items.push(item)
    }

    job_application dequeue() {
        vibe_check (me_fr.items.length == 0) {
            its_giving ghost
        }
        its_giving me_fr.items.shift()
    }

    job_application front() {
        vibe_check (me_fr.items.length == 0) {
            its_giving ghost
        }
        its_giving me_fr.items[0]
    }

    job_application isEmpty() {
        its_giving me_fr.items.length == 0
    }

    job_application size() {
        its_giving me_fr.items.length
    }
}

squad LinkedListNode {
    job_application constructor(value) {
        me_fr.value = value
        me_fr.next = ghost
    }
}

squad LinkedList {
    job_application constructor() {
        me_fr.head = ghost
        me_fr.size = 0
    }

    job_application append(value) {
        lock_in newNode = spawn LinkedListNode(value)
        vibe_check (me_fr.head == ghost) {
            me_fr.head = newNode
        } big_yikes {
            lock_in current = me_fr.head
            goon (current.next != ghost) {
                current = current.next
            }
            current.next = newNode
        }
        me_fr.size = me_fr.size + 1
    }

    job_application prepend(value) {
        lock_in newNode = spawn LinkedListNode(value)
        newNode.next = me_fr.head
        me_fr.head = newNode
        me_fr.size = me_fr.size + 1
    }

    job_application remove(value) {
        vibe_check (me_fr.head == ghost) {
            its_giving no_cap
        }
        vibe_check (me_fr.head.value == value) {
            me_fr.head = me_fr.head.next
            me_fr.size = me_fr.size - 1
            its_giving wallahi
        }
        lock_in current = me_fr.head
        goon (current.next != ghost && current.next.value != value) {
            current = current.next
        }
        vibe_check (current.next == ghost) {
            its_giving no_cap
        }
        current.next = current.next.next
        me_fr.size = me_fr.size - 1
        its_giving wallahi
    }

    job_application contains(value) {
        lock_in current = me_fr.head
        goon (current != ghost) {
            vibe_check (current.value == value) {
                its_giving wallahi
            }
            current = current.next
        }
        its_giving no_cap
    }

    job_application toArray() {
        lock_in result = []
        lock_in current = me_fr.head
        goon (current != ghost) {
            result.push(current.value)
            current = current.next
        }
        its_giving result
    }
}

job_application binarySearch(arr, target) {
    lock_in left = 0
    lock_in right = arr.length - 1
    goon (left <= right) {
        lock_in mid = Math.floor((left + right) / 2)
        vibe_check (arr[mid] == target) {
            its_giving mid
        }
        vibe_check (arr[mid] < target) {
            left = mid + 1
        } big_yikes {
            right = mid - 1
        }
    }
    its_giving -1
}

job_application bubbleSort(arr) {
    lock_in n = arr.length
    flex (whatever i = 0; i < n - 1; i = i + 1) {
        flex (whatever j = 0; j < n - i - 1; j = j + 1) {
            vibe_check (arr[j] > arr[j + 1]) {
                lock_in temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
    its_giving arr
}

job_application main() {
    lock_in stack = spawn Stack()
    stack.push(10)
    stack.push(20)
    stack.push(30)
    console.log("Stack pop:", stack.pop())
    console.log("Stack peek:", stack.peek())

    lock_in queue = spawn Queue()
    queue.enqueue(1)
    queue.enqueue(2)
    queue.enqueue(3)
    console.log("Queue dequeue:", queue.dequeue())
    console.log("Queue front:", queue.front())

    lock_in list = spawn LinkedList()
    list.append(5)
    list.append(10)
    list.append(15)
    list.prepend(0)
    console.log("List contains 10:", list.contains(10))
    console.log("List as array:", list.toArray())

    lock_in sortedArr = [1, 3, 5, 7, 9, 11, 13]
    console.log("Binary search for 7:", binarySearch(sortedArr, 7))
    console.log("Binary search for 6:", binarySearch(sortedArr, 6))

    lock_in unsorted = [64, 34, 25, 12, 22, 11, 90]
    console.log("Bubble sort:", bubbleSort(unsorted))

    console.log("Factorial of 5:", factorial(5))
    console.log("Fibonacci of 10:", fibonacci(10))
}

main()
